    "n26" [label="cargo (./xtask/rules_check): rules_check v0.0.0", shape=ellipse, fillcolor="#EB984E", penwidth=1.5];
    "n17" [label="Cargo.toml", shape=note, fillcolor="#FADBD8", penwidth=1];
  }

  subgraph cluster_4 {
    label="libs_bench";
    style=filled; color="#2E86C1"; fillcolor="#2E86C120";
