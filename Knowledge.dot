    "n25" [label="cargo (./xtask/libs_bench): xtask_libs_bench v0.0.0", shape=ellipse, fillcolor="#EB984E", penwidth=1.5];
    "n15" [label="Cargo.toml", shape=note, fillcolor="#FADBD8", penwidth=1];
  }

  subgraph cluster_5 {
    label="coverage";
    style=filled; color="#2E86C1"; fillcolor="#2E86C120";
