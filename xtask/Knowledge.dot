digraph G {
  newrank=true;
  rankdir=LR;
  splines=ortho;
  overlap=false;
  nodesep=0.5;
  ranksep=0.5;
  concentrate=true;
  graph [bgcolor="#f9f9f9", color="#888888", penwidth=2, fontname="Arial"];
  node [fontname="Arial", fontsize=14, style=filled, margin="0.3,0.2"];
  edge [fontname="Arial", fontsize=10, color="#555555", fontcolor="gray"];
  subgraph cluster_1 {
    label="root";
    style=filled; color="#5DADE2"; fillcolor="#5DADE220";
    "n0" [label="root", shape=folder, fillcolor="#5DADE2", penwidth=1.5];
    "n13" [label="cargo (.): xtask v0.0.0", shape=ellipse, fillcolor="#EB984E", penwidth=1.5];
  subgraph cluster_2 {
    label="rules_check";
    style=filled; color="#3498DB"; fillcolor="#3498DB20";
    "n10" [label="rules_check", shape=folder, fillcolor="#3498DB", penwidth=1.5];
    "n17" [label="cargo (./rules_check): rules_check v0.0.0", shape=ellipse, fillcolor="#EB984E", penwidth=1.5];
    "n11" [label="Cargo.toml", shape=note, fillcolor="#FADBD8", penwidth=1];
  }

  subgraph cluster_3 {
    label="libs_bench";
    style=filled; color="#3498DB"; fillcolor="#3498DB20";
    "n8" [label="libs_bench", shape=folder, fillcolor="#3498DB", penwidth=1.5];
    "n16" [label="cargo (./libs_bench): xtask_libs_bench v0.0.0", shape=ellipse, fillcolor="#EB984E", penwidth=1.5];
    "n9" [label="Cargo.toml", shape=note, fillcolor="#FADBD8", penwidth=1];
  }

  subgraph cluster_4 {
    label="coverage";
    style=filled; color="#3498DB"; fillcolor="#3498DB20";
    "n6" [label="coverage", shape=folder, fillcolor="#3498DB", penwidth=1.5];
    "n15" [label="cargo (./coverage): xtask_coverage v0.0.0", shape=ellipse, fillcolor="#EB984E", penwidth=1.5];
    "n7" [label="Cargo.toml", shape=note, fillcolor="#FADBD8", penwidth=1];
  }

  subgraph cluster_5 {
    label="codegen";
    style=filled; color="#3498DB"; fillcolor="#3498DB20";
    "n4" [label="codegen", shape=folder, fillcolor="#3498DB", penwidth=1.5];
    "n14" [label="cargo (./codegen): xtask_codegen v0.0.0", shape=ellipse, fillcolor="#EB984E", penwidth=1.5];
    "n5" [label="Cargo.toml", shape=note, fillcolor="#FADBD8", penwidth=1];
  }

    "n3" [label="Cargo.toml", shape=note, fillcolor="#FADBD8", penwidth=1];
  subgraph cluster_6 {
    label="bench";
    style=filled; color="#3498DB"; fillcolor="#3498DB20";
    "n1" [label="bench", shape=folder, fillcolor="#3498DB", penwidth=1.5];
    "n12" [label="cargo (./bench): xtask_bench v0.0.0", shape=ellipse, fillcolor="#EB984E", penwidth=1.5];
    "n2" [label="Cargo.toml", shape=note, fillcolor="#FADBD8", penwidth=1];
  }

  }

  "n0" -> "n1" [label="Contain", style=solid, color="blue", weight=2, arrowsize=0.8];
  "n1" -> "n2" [label="Contain", style=solid, color="blue", weight=2, arrowsize=0.8];
  "n0" -> "n3" [label="Contain", style=solid, color="blue", weight=2, arrowsize=0.8];
  "n0" -> "n4" [label="Contain", style=solid, color="blue", weight=2, arrowsize=0.8];
  "n4" -> "n5" [label="Contain", style=solid, color="blue", weight=2, arrowsize=0.8];
  "n0" -> "n6" [label="Contain", style=solid, color="blue", weight=2, arrowsize=0.8];
  "n6" -> "n7" [label="Contain", style=solid, color="blue", weight=2, arrowsize=0.8];
  "n0" -> "n8" [label="Contain", style=solid, color="blue", weight=2, arrowsize=0.8];
  "n8" -> "n9" [label="Contain", style=solid, color="blue", weight=2, arrowsize=0.8];
  "n0" -> "n10" [label="Contain", style=solid, color="blue", weight=2, arrowsize=0.8];
  "n10" -> "n11" [label="Contain", style=solid, color="blue", weight=2, arrowsize=0.8];
  "n1" -> "n12" [label="Contain", style=solid, color="blue", weight=2, arrowsize=0.8];
  "n0" -> "n13" [label="Contain", style=solid, color="blue", weight=2, arrowsize=0.8];
  "n4" -> "n14" [label="Contain", style=solid, color="blue", weight=2, arrowsize=0.8];
  "n6" -> "n15" [label="Contain", style=solid, color="blue", weight=2, arrowsize=0.8];
  "n8" -> "n16" [label="Contain", style=solid, color="blue", weight=2, arrowsize=0.8];
  "n10" -> "n17" [label="Contain", style=solid, color="blue", weight=2, arrowsize=0.8];
  subgraph cluster_legend {
    label="Legend"; fontsize=14; style=dashed; color=gray;
    "dir" [label="Directory", shape=folder, fillcolor="#5DADE2"];
    "file" [label="File", shape=note, fillcolor="#FADBD8"];
    "pkg" [label="Package", shape=ellipse, fillcolor="#EB984E"];
    "ext" [label="External", shape=trapezium, fillcolor="#EC7063"];
    "dir" -> "file" [label="Contain", style=solid, color=blue];
    "pkg" -> "ext" [label="Dependency", style=dashed, color=red];
  }
}
